[Unit]
Description=rent_msk: бот в телеграме, один процесс с длинным опросом
After=network-online.target docker.service

[Service]
WorkingDirectory=%h/rent_msk
Environment=RENT_BOT_ENV=prod
Environment=TZ=Europe/Moscow
Environment=PATH=%h/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/rent_msk/.venv/bin/python -m bot
# Выход по собственному сторожу пульса или падение: поднять чистый.
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
