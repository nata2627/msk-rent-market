# Данные: сырые снимки, база, выгрузки — никогда не в репозиторий.
data/
# Исключение: агрегаты публичной витрины. Только агрегаты, ячейки от
# порога проекта, см. src/site_data.py.
!site/data/
*.db
*.sqlite

# Окружение
.venv/
.venv-dbt/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Служебное dbt: собранный SQL и журналы, пересоздаются каждым запуском
dbt/target/
dbt/logs/
dbt/.user.yml

# Секреты и локальные настройки
.env

# Рабочие заметки: остаются на машине, в репозиторий не идут.
docs/

# Личное: критерии поиска, переписка с арендодателями, заметки к собеседованиям
personal/
notes/

.DS_Store
