# Скопировать в .env: cp .env.example .env
# Порт 5433, а не 5432: на 5432 уже висит база проекта moex-market-analytics.
POSTGRES_DB=rent
POSTGRES_USER=rent
POSTGRES_PASSWORD=rent
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Вежливость сбора. Пауза берётся как случайная величина из [PAUSE_MIN, PAUSE_MAX].
CIAN_PAUSE_MIN=2.0
CIAN_PAUSE_MAX=3.5

# Порт раздачи GeoJSON с границами районов для карты в Metabase
GEOJSON_PORT=8081

# Соль для псевдонимизации идентификатора продавца. Менять на своё
# значение; в репозиторий .env не попадает.
SELLER_ID_SALT=change-me

# Metabase соседнего проекта moex-market-analytics, где собирается дашборд.
# Пароль в репозиторий не кладётся: он от чужого стенда, и публичный
# репозиторий сделал бы его общедоступным.
METABASE_URL=http://localhost:3000
METABASE_USER=
METABASE_PASSWORD=
METABASE_DB_ID=

# Сбор в контейнере (Mac mini): песочница Chrome требует прав, которых у
# непривилегированного контейнера нет, и без флага браузер не стартует.
# На макбуке переменная не нужна — там Chrome запускается как обычно.
# Подробности и остальные условия — docs/operations.md.
CHROME_NO_SANDBOX=

# ------------------------------------------------------------------
# Доклад об ошибках наружу (scripts/box_notify.sh)
# ------------------------------------------------------------------
# Зачем. 21.10.2026 заклинивший обход девятнадцать часов держал замок и
# почти съел день панели; дашборд до 22.10.2026 десять дней показывал
# мёртвую копию базы. Оба раза всё было в журналах — и оба раза о беде
# узнали только потому, что спросили сами.
#
# Нужно заполнить ОДНО из двух. Ни то ни другое не заполнено — беда
# по-прежнему пишется в data/logs/box_notify.log, а наружу не уходит
# ничего; прогон от этого не падает. Проверить канал: make notify-test.
#
# Способ первый, ntfy: учётка не нужна вовсе. Придумать своё длинное
# слово (оно и есть секрет: кто знает топик, тот читает и пишет в него),
# поставить приложение ntfy на телефон и подписаться на то же слово.
#
# В работе НЕ используется с 22.10.2026: оставлен как запасной. Пока бота
# не было, уведомления шли сюда; как только телеграм заработал, строку
# убрали — неиспользуемый канал продолжал бы гнать числа панели и адрес
# бокса через чужой публичный сервис.
NOTIFY_NTFY_URL=
#
# Способ второй, бот телеграма: токен от @BotFather, id чата — свой
# собственный. Заполняются не руками, а командой make notify-tg: она
# проверит токен, сама найдёт id чата и впишет обе строки здесь и на
# боксе. Бота всё равно заводить руками: @BotFather разговаривает только
# с живым аккаунтом.
#
# Заполнено и то и это — сообщение уходит в ОБА канала. Читают обычно
# один, и беда, ушедшая в другой, равносильна беде, не ушедшей никуда.
NOTIFY_TG_TOKEN=
NOTIFY_TG_CHAT=
#
# Окно ограничения частоты в часах: одно сообщение на тип события за
# столько часов. Сторож ходит раз в двадцать минут, и без окна одна беда
# улетела бы семьдесят два раза за сутки. По умолчанию 6 — ровно срок
# давности замка; рассуждение целиком в scripts/box_notify.sh.
NOTIFY_WINDOW_H=6

# ---------------------------------------------------------------------
# Машина сбора (Mac mini). Прогон живёт там с 12.10.2026, а отсюда к ней
# ходят два скрипта: перелив базы для дашборда (make pull-box) и
# подключение телеграма (make notify-tg).
#
# В коде этих значений нет намеренно: репозиторий публичный, и адрес
# домашней сети в нём не нужен никому, кроме владельца.
BOX_SSH_HOST=
BOX_SSH_PORT=22
BOX_SSH_USER=
